# Copy this file to .env for local development. Never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Optional: enables the Gemini-backed health assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
